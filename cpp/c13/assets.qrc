<RCC>
    <qresource prefix="/fonts/B612">
        <file alias="B612-Bold.ttf">assets/fonts/B612/B612-Bold.ttf</file>
        <file alias="B612-BoldItalic.ttf">assets/fonts/B612/B612-BoldItalic.ttf</file>
        <file alias="B612-Italic.ttf">assets/fonts/B612/B612-Italic.ttf</file>
        <file alias="B612-Regular.ttf">assets/fonts/B612/B612-Regular.ttf</file>
    </qresource>
    <qresource prefix="/fonts/B612_Mono">
        <file alias="B612Mono-Bold.ttf">assets/fonts/B612_Mono/B612Mono-Bold.ttf</file>
        <file alias="B612Mono-BoldItalic.ttf">assets/fonts/B612_Mono/B612Mono-BoldItalic.ttf</file>
        <file alias="B612Mono-Italic.ttf">assets/fonts/B612_Mono/B612Mono-Italic.ttf</file>
        <file alias="B612Mono-Regular.ttf">assets/fonts/B612_Mono/B612Mono-Regular.ttf</file>
    </qresource>
</RCC>
