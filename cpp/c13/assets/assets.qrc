<RCC>
    <qresource prefix="/fonts/B612">
        <file alias="B612-Bold.ttf">fonts/B612/B612-Bold.ttf</file>
        <file alias="B612-BoldItalic.ttf">fonts/B612/B612-BoldItalic.ttf</file>
        <file alias="B612-Italic.ttf">fonts/B612/B612-Italic.ttf</file>
        <file alias="B612-Regular.ttf">fonts/B612/B612-Regular.ttf</file>
    </qresource>
    <qresource prefix="/fonts/B612_Mono">
        <file alias="B612Mono-Bold.ttf">fonts/B612_Mono/B612Mono-Bold.ttf</file>
        <file alias="B612Mono-BoldItalic.ttf">fonts/B612_Mono/B612Mono-BoldItalic.ttf</file>
        <file alias="B612Mono-Italic.ttf">fonts/B612_Mono/B612Mono-Italic.ttf</file>
        <file alias="B612Mono-Regular.ttf">fonts/B612_Mono/B612Mono-Regular.ttf</file>
    </qresource>
    <qresource prefix="/sql">
        <file alias="init.sql">sql/init.sql</file>
        <file alias="migrate_0001_to_0002.sql">sql/migrate_0001_to_0002.sql</file>
    </qresource>
    <qresource prefix="/shaders">
        <file alias="blinn_phong_frag.glsl">shaders/blinn_phong_frag.glsl</file>
        <file alias="blinn_phong_vertex.glsl">shaders/blinn_phong_vertex.glsl</file>
    </qresource>
    <qresource prefix="/meshes">
        <file alias="icosphere4.obj">meshes/icosphere4.obj</file>
    </qresource>
</RCC>
